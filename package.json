{
  "name": "musai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "analyze:fixtures": "npx tsx scripts/analyze-test-recordings.ts",
    "fixtures:synth": "npx tsx scripts/generate-synth-fixtures.ts",
    "test:phase02": "npx tsx scripts/generate-synth-fixtures.ts && npx tsx scripts/phase02-fixture-check.ts"
  },
  "allowScripts": {
    "sharp": true,
    "unrs-resolver": true
  },
  "dependencies": {
    "animejs": "^4.5.0",
    "next": "16.2.2",
    "pitchy": "^4.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "vexflow": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vexflow-fonts/bravura": "^1.0.2",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "jsdom": "^29.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  }
}
