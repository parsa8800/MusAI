# OpenAI (optional) — scale results tip + live coach chat upgrade when set.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# false = template coaching only (no API spend). true = live calls when key is set.
OPENAI_ENABLED=false

# Optional override (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Piece Studio sheet-music reading (PDF / PNG / JPG → digital score).
# Audiveris runs in a dedicated worker — never inside Next.js / Vercel.
#
# Local prototype (recommended):
#   1. Install Java 17+ and Audiveris (or use Docker — see services/omr-worker/README.md)
#   2. Optional: brew install poppler  (≈300 DPI PDF pages)
#   3. npm run omr-worker
#   4. Uncomment:
MUSAI_OMR_PROVIDER=audiveris
MUSAI_OMR_URL=http://127.0.0.1:8090
# MUSAI_OMR_TOKEN=
#
# In non-production, Piece Studio defaults to the Audiveris worker on :8090
# even if these are unset — but the worker must be running with Audiveris.
#
# Option B — Flat.io Interactive Jobs (paid credits per page):
# MUSAI_OMR_PROVIDER=flat
# MUSAI_FLAT_API_TOKEN=
#
# Option C — generic sync HTTP engine that returns MusicXML in one response:
# MUSAI_OMR_PROVIDER=http
# MUSAI_OMR_URL=
# MUSAI_OMR_TOKEN=
#
# Production: set MUSAI_OMR_PROVIDER explicitly (unset stays unavailable).
# Digital MusicXML/MXL upload works without any OMR worker.
